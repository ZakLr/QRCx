__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Raw NOAA ISD-Lite downloads (regenerated by QRCx/data/loader.py)
data/isd/*.txt
data/isd/*.gz
QRCx/data/isd/*.txt
QRCx/data/isd/*.gz

# Regeneratable GPU-handoff export (scripts/sprint4_export_pilot_seq.py)
data/sprint4_pilot_seq.npz

# Regeneratable canonical-split export (scripts/phase1_export_canonical_seq.py)
data/canonical_seq.npz

# Regeneratable driven feature arrays (scripts/phase2_drive_pilot_features.py) --
# large (2.6MB each), regenerated in ~45min by the script; target_series.npy and
# meta.json are small and kept for reproducibility reference.
results/phase2_features/v5_features_tuned.npy
results/phase2_features/v5_features_diagnostic_off.npy

# Regeneratable canonical-split GPU-driven feature arrays (large, 47MB each;
# scripts/phase1_v5_canonical_drive.py / scripts/phase5_v4_canonical_drive.py) --
# the summary JSONs (small) are kept, the raw feature arrays are not.
results/phase1_v5_canonical/*.npy
results/phase5_v4_features_*.npy

# Stray local run logs
phase2_drive_log.txt
phase1_drive_log.txt

# LaTeX build artifacts (docs/paper/main.pdf is committed; these are not)
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/compile_log.txt

# Local cache/results scratch
cache/
*.cache
*.zip

# Extracted zip-inspection copy (a duplicate of this entire repo, produced
# by unzipping QRCx_Challenge_Phase3.zip for judge-dry-run inspection) --
# never a source directory, must never be tracked.
QRCx_Challenge_Phase3/
results/*.npz
.claude/
.env
.env.*
secrets/
